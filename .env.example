# Copy to .env, then replace placeholders. Never commit .env.
BOT_TOKEN=replace-with-telegram-bot-token
OPENROUTER_API_KEY=replace-with-openrouter-key
WEB_ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional when storage.driver = postgres
DATABASE_URL=postgres://warden:local-only@localhost:5432/warden?sslmode=disable
